+// Hand target position per Controller-Taste setzen.
+// Voraussetzung: In der deploy.yaml der Hand-Policy gibt es eine Observation
+// "hand_target_position". Diese Funktion überschreibt deren Berechnung und
+// liefert bei bestimmten Gamepad-Tasten feste XYZ-Ziele für die Hand.
+//
+// Mapping:
+//   A.on_pressed -> [0.3, 0.2, 0.25]
+//   B.on_pressed -> [0.2, 0.1, 0.15]
+//   X.on_pressed -> [0.0, 0.0, 0.0] (Reset)
+REGISTER_OBSERVATION(hand_target_position)
+{
+    // Bisheriges Ziel merken, damit es gehalten wird, wenn keine neue Taste gedrückt wird.
+    static std::vector<float> cmd = {0.25f, 0.15f, 0.2f} ; // default values
+
+    // Joystick vom Roboter holen
+    auto* joystick = env->robot->data.joystick;
+    if (joystick != nullptr)
+    {
+        // A: erste Ziel-Pose
+        if (joystick->right.on_pressed)
+        {
+            cmd[0] = 0.5f;
+            cmd[1] = 0.2f;
+            cmd[2] = 0.25f;
+        }
+        // B: zweite Ziel-Pose
+        else if (joystick->down.on_pressed)
+        {
+            cmd[0] = 0.4f;
+            cmd[1] = 0.1f;
+            cmd[2] = 0.15f;
+        }
+        // X: Reset
+        else if (joystick->X.on_pressed)
+        {
+            cmd[0] = 0.25f;
+            cmd[1] = 0.15f;
+            cmd[2] = 0.2f;
+        }
+    }
+
+    return cmd;
+}
+
+// Hand position commands for tracking/publishing
+// Note: This observation needs to be added to deploy.yaml to work properly
+// It will try to call hand_target_position observation if registered
+REGISTER_OBSERVATION(hand_position_commands_for_tracking)
+{
+    std::vector<float> cmd = {0.0f, 0.0f, 0.0f};
+    
+    // Try to call hand_target_position observation if it's registered
+    // Note: hand_target_position is a Python-defined observation, so this may not work
+    // directly. The user should ensure hand_target_position is in the deploy.yaml
+    // observations, and this observation can then extract it from the observation manager
+    try {
+        auto& obs_map = observations_map();
+        if (obs_map.find("hand_target_position") != obs_map.end()) {
+            YAML::Node params;
+            params["command_name"] = "hand_position";
+            auto hand_target = obs_map["hand_target_position"](env, params);
+            if (hand_target.size() >= 3) {
+                cmd[0] = hand_target[0];
+                cmd[1] = hand_target[1];
+                cmd[2] = hand_target[2];
+            }
+        }
+    } catch(const std::exception& e) {
+        // If hand_target_position is not registered or fails, return zeros
+        // This is expected if hand_target_position is Python-only
+    }
+    
+    return cmd;
+}
+
 }
 
